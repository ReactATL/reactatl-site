---
import Layout from "@/layouts/Layout.astro";
import { FilterableEvents } from "@/components/FilterableEvents";
import { getEventList } from "@/lib/events";

const events = await getEventList();
---

<Layout
  title="Events — ReactATL"
  description="Every ReactATL meetup — talks, workshops, and community nights."
>
  <main class="bg-background">
    <section class="px-4 pb-8 pt-16 md:px-6 md:pt-24">
      <div class="mx-auto max-w-7xl">
        <h1
          class="text-balance text-[clamp(2.5rem,6vw,4rem)] font-black uppercase leading-none tracking-tight"
        >
          Events
        </h1>
        <p class="mt-4 max-w-xl text-muted-foreground">
          Every ReactATL meetup — talks, workshops, and community nights.
        </p>
      </div>
    </section>
    <FilterableEvents client:load events={events} />
  </main>
</Layout>
