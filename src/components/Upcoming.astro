---
import EventCard from "./ui/EventCard.astro";
import Badge from "./ui/Badge.astro";
---

<section id='events' class='w-full py-12 md:py-24 lg:py-32'>
  <div class='container px-4 md:px-6'>
    <div
      class='flex flex-col items-center justify-center space-y-4 text-center'
    >
      <div class='space-y-2'>
        <Badge class='mx-auto' variant='primaryOutline'>
          What&apos;s Happening
        </Badge>
        <h2 class='text-3xl font-bold tracking-tighter sm:text-5xl'>
          Upcoming Events
        </h2>
        <p
          class='max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed'
        >
          Join us for our upcoming meetups, workshops, and special events.
        </p>
      </div>
    </div>
    <div class='mx-auto grid max-w-5xl items-center gap-6 py-12 lg:grid-cols-3'>
      <EventCard
        title='React 19 Deep Dive'
        subtitle='Explore the latest features in React 19 with live coding examples.'
        date='June 15'
        image='/placeholder.svg?height=200&width=400'
      />
    </div>
    <div class='flex justify-center'>
      <!-- <Button variant='outline' size='lg'>
        View All Events
        <ChevronRight class='ml-2 h-4 w-4' />
      </Button> -->
    </div>
  </div>
</section>
