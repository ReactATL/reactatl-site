---
import BentoEventCard from "./ui/BentoEventCard.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const upcomingEvents = allEvents.filter((event) => event.data.upcoming);
---

<section id="events" class="px-4 pb-16 md:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex items-center justify-between">
      <h2
        class="text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground"
      >
        Upcoming Events
      </h2>
      <a
        href="#"
        class="flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        View All
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-3 md:grid-rows-2">
      {/* Featured Large Card */}
      {
        upcomingEvents[0] && (
          <div class="relative overflow-hidden md:col-span-1 md:row-span-2">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/20 via-blue-500/10 to-emerald-500/20" />
            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent" />
            <BentoEventCard
              title={upcomingEvents[0].data.title}
              date={upcomingEvents[0].data.date}
              time={upcomingEvents[0].data.time}
              location={upcomingEvents[0].data.location}
              tags={upcomingEvents[0].data.tags}
              link={upcomingEvents[0].data.link}
              variant="dark"
              size="large"
            />
          </div>
        )
      }

      {/* Second Card */}
      {
        upcomingEvents[1] && (
          <div class="md:col-span-1">
            <BentoEventCard
              title={upcomingEvents[1].data.title}
              date={upcomingEvents[1].data.date}
              time={upcomingEvents[1].data.time}
              location={upcomingEvents[1].data.location}
              tags={upcomingEvents[1].data.tags}
              link={upcomingEvents[1].data.link}
              variant="light"
              size="medium"
            />
          </div>
        )
      }

      {/* Third Card */}
      {
        upcomingEvents[2] && (
          <div class="md:col-span-1">
            <BentoEventCard
              title={upcomingEvents[2].data.title}
              date={upcomingEvents[2].data.date}
              time={upcomingEvents[2].data.time}
              location={upcomingEvents[2].data.location}
              tags={upcomingEvents[2].data.tags}
              link={upcomingEvents[2].data.link}
              variant="light"
              size="medium"
            />
          </div>
        )
      }

      {/* Community Stats Card */}
      <div class="relative overflow-hidden md:col-span-2">
        <div
          class="flex h-full flex-col justify-between rounded-lg border border-border bg-card/50 p-6 backdrop-blur-sm"
        >
          {/* Subtle gradient accent */}
          <div
            class="pointer-events-none absolute -right-20 -top-20 h-40 w-40 rounded-full bg-gradient-to-br from-orange-400/20 via-amber-300/10 to-transparent blur-2xl"
          >
          </div>

          <div class="relative">
            <p class="mb-2 text-sm uppercase tracking-wider text-muted-foreground">
              Atlanta, Georgia
            </p>
            <h3
              class="mb-4 max-w-md text-balance text-xl font-bold uppercase tracking-tight md:text-2xl"
            >
              Atlanta's Premier React Developer Community
            </h3>
          </div>
          <div class="relative flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="text-4xl font-black md:text-5xl">200+</span>
              <span class="text-muted-foreground">members</span>
            </div>
            <a
              href="https://www.meetup.com/react-atl"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-foreground bg-transparent px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-foreground hover:text-background"
            >
              Join Community
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
