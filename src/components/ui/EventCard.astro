---
import Badge from "./Badge.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  date: string;
  image?: string;
  location?: string;
  time?: string;
}

const { title, subtitle, description, date, image, location, time } =
  Astro.props;
---

<a
  href='#'
  class='card preset-filled-surface-100-900 border-[1px] border-surface-200-800 card-hover divide-surface-200-800 block max-w-lg divide-y overflow-hidden p-4'
>
  <header class='flex justify-end mb-4 pb-4'>
    <Badge variant='primaryOutline'>
      {date}
    </Badge>
  </header>
  <article class='mb-4 pb-4'>
    {
      image ? (
        <Image
          src={image}
          alt='React 19 Deep Dive'
          class='rounded-md object-cover w-full'
          width={450}
          height={190}
        />
      ) : (
        <div class='h-[190px] w-full bg-surface-200/20 rounded-md' />
      )
    }
    <div class='mt-4 space-y-2'>
      <h2 class='h3'>{title}</h2>
      <h3 class='h6'>{subtitle}</h3>
      <p class='opacity-60'>{description}</p>
      <div>
        {
          location && (
            <div class='flex items-center gap-2'>
              <Icon name='lucide:map-pin' />
              <span class='text-sm text-muted-foreground'>{location}</span>
            </div>
          )
        }
        {
          time && (
            <div class='flex items-center gap-2'>
              <Icon name='lucide:calendar' />
              <span class='text-sm text-muted-foreground'>{time}</span>
            </div>
          )
        }
      </div>
    </div>
  </article>
  <footer class='flex items-center justify-center gap-4 p-4'>
    <button class='btn btn-lg preset-tonal-primary'>Register Now</button>
  </footer>
</a>
