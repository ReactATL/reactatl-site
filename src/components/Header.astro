---
import { Icon } from "astro-icon/components";
---

<header
  class='sticky top-0 z-50 border-b-[1px] border-surface-500/20 bg-surface-50/90 dark:bg-surface-950/90 backdrop-blur w-full h-[70px] flex items-center'
>
  <div
    class='container mx-auto grid max-w-screen-2xl grid-cols-[auto_1fr_auto] xl:grid-cols-[1fr_auto_1fr] items-center gap-4 px-4 xl:px-10'
  >
    <!-- Left -->
    <div class='flex items-stretch justify-start gap-4'>
      <div class='flex items-center gap-2'>
        <Icon name='simple-icons:react' />
        <span class='text-xl font-bold'>ReactATL</span>
      </div>
    </div>
    <!-- Middle -->
    <nav class='hidden md:flex items-center gap-4'>
      <a href='#events' class='text-sm font-medium hover:text-primary'>
        Events
      </a>
      <a href='#previous' class='text-sm font-medium hover:text-primary'>
        Previous Meetups
      </a>
      <a href='#partners' class='text-sm font-medium hover:text-primary'>
        Partner Meetups
      </a>
      <a href='#about' class='text-sm font-medium hover:text-primary'>
        About
      </a>
    </nav>
    <button type='button' class='btn preset-tonal-primary w-fit'>
      Join Community</button
    >
  </div>
</header>
