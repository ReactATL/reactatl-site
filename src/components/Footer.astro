---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const allSocials = await getCollection("socials");
---

<footer class='border-t border-border px-4 py-12 md:px-6'>
  <div class='mx-auto max-w-7xl'>
    <div class='grid gap-8 md:grid-cols-4'>
      <!-- Brand Column -->
      <div class='md:col-span-1'>
        <h3 class='mb-4 text-xl font-black uppercase tracking-tight'>
          reactATL
        </h3>
        <p class='text-sm text-muted-foreground'>
          Atlanta's React developer community. Connect, collaborate, and grow
          with us.
        </p>
        <p
          class='mt-4 text-xl text-foreground/70'
          style="font-family: 'Caveat', cursive;"
        >
          Come out to learn and connect
        </p>
      </div>

      <!-- reactATL Links -->
      <div>
        <h4
          class='mb-4 text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground'
        >
          reactATL
        </h4>
        <ul class='space-y-2'>
          <li>
            <a href='#' class='text-sm text-foreground hover:underline'>
              Overview
            </a>
          </li>
          <li>
            <a href='#events' class='text-sm text-foreground hover:underline'>
              Events
            </a>
          </li>
          <li>
            <a href='#about' class='text-sm text-foreground hover:underline'>
              About
            </a>
          </li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4
          class='mb-4 text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground'
        >
          Connect
        </h4>
        <ul class='space-y-2'>
          {
            allSocials.map((social) => (
              <li>
                <a
                  href={social.data.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='text-sm text-foreground hover:underline'
                >
                  {social.data.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class='mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row'
    >
      <p class='text-sm text-muted-foreground'>
        &copy; {new Date().getFullYear()} reactATL. Built by
        <a
          href='https://bsky.app/profile/martinrojas.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='underline hover:text-foreground'
        >
          Martin Rojas
        </a>.
      </p>
      <div class='flex items-center gap-2'>
        <div
          class='flex h-8 w-8 items-center justify-center rounded-full bg-white p-1'
        >
          <img
            src='/reactatl-logo-sq.svg'
            alt='ReactATL Logo'
            class='h-full w-full'
          />
        </div>
        <span class='font-black uppercase tracking-tight'>reactATL</span>
      </div>
    </div>
  </div>
</footer>
