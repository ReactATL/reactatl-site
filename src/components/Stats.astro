---

---

<section
  class='relative overflow-hidden border-t border-border px-4 py-12 md:px-6 md:py-16'
>
  <!-- Background gradient -->
  <div class='pointer-events-none absolute inset-0'>
    <div
      class='absolute left-1/3 top-0 h-64 w-64 rounded-full bg-gradient-to-br from-pink-500/10 via-rose-400/5 to-transparent blur-3xl'
    >
    </div>
    <div
      class='absolute bottom-0 right-1/4 h-48 w-48 rounded-full bg-gradient-to-br from-cyan-500/10 via-blue-400/5 to-transparent blur-3xl'
    >
    </div>
  </div>

  <div class='relative mx-auto max-w-7xl'>
    <div class='grid gap-4 md:grid-cols-3'>
      <div
        class='rounded-lg border border-border bg-card/50 p-6 backdrop-blur-sm'
      >
        <span class='text-5xl font-black md:text-6xl'>4000+</span>
        <p class='mt-2 text-sm uppercase tracking-wider text-muted-foreground'>
          Members
        </p>
      </div>
      <div
        class='rounded-lg border border-border bg-card/50 p-6 backdrop-blur-sm'
      >
        <span class='text-5xl font-black md:text-6xl'>10+</span>
        <p class='mt-2 text-sm uppercase tracking-wider text-muted-foreground'>
          Years Active
        </p>
      </div>
      <div
        class='relative overflow-hidden rounded-lg bg-foreground p-6 text-background'
      >
        <!-- Gradient accent on dark card -->
        <div
          class='pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-gradient-to-br from-cyan-400/30 via-blue-500/20 to-transparent blur-2xl'
        >
        </div>
        <span class='relative text-5xl font-black md:text-6xl'>Monthly</span>
        <p
          class='relative mt-2 text-sm uppercase tracking-wider text-background/70'
        >
          Meetups
        </p>
      </div>
    </div>
  </div>
</section>
