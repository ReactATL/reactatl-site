---
import BentoEventCard from "./ui/BentoEventCard.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const pastEvents = allEvents.filter((event) => !event.data.upcoming);
---

<section id="previous" class="border-t border-border px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex items-center justify-between">
      <h2
        class="text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground"
      >
        Past Events
      </h2>
      <a
        href="#"
        class="flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        More Stories
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        pastEvents.map((event, index) => (
          <BentoEventCard
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            tags={event.data.tags}
            link={event.data.link}
            variant={index === 0 ? "dark" : "light"}
            size="small"
          />
        ))
      }
    </div>
  </div>
</section>
