---
import Badge from "./ui/Badge.astro";
import EventCard from "./ui/EventCard.astro";

import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
---

<section id='previous' class='w-full py-12 md:py-24 lg:py-32 bg-muted'>
  <div class='container px-4 md:px-6'>
    <div
      class='flex flex-col items-center justify-center space-y-4 text-center'
    >
      <div class='space-y-2'>
        <Badge class='mx-auto' variant='primaryOutline'> Look Back </Badge>
        <h2 class='text-3xl font-bold tracking-tighter sm:text-5xl'>
          Previous Meetups
        </h2>
        <p
          class='max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed'
        >
          Catch up on what you missed from our past events.
        </p>
      </div>
    </div>
    <div class='mx-auto grid max-w-5xl items-center gap-6 py-12 lg:grid-cols-3'>
      {console.log(allEvents)}
      {
        allEvents.map((event) =>
          !event.data.upcoming ? (
            <EventCard
              title={event.data.title}
              subtitle={event.data.subtitle}
              description={event.data.description || ""}
              link={event.data.link}
              date={event.data.date}
              image={event.data.image}
              location={event.data.location}
              time={event.data.time}
            />
          ) : null
        )
      }
    </div>
  </div>
</section>
